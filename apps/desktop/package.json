{
  "name": "@videoinsight/class-button-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron classroom player for VideoInsight Class Button",
  "author": "VideoInsight",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "cargo build --manifest-path ../../class-button/Cargo.toml --bin class-button-sidecar && electron-vite dev",
    "dev:demo": "cargo build --manifest-path ../../class-button/Cargo.toml --bin class-button-sidecar && electron-vite dev -- --demo",
    "build": "electron-vite build",
    "build:sidecar": "cargo build --release --manifest-path ../../class-button/Cargo.toml --bin class-button-sidecar && node scripts/stage-sidecar.mjs",
    "package:mac": "pnpm build:sidecar && pnpm build && electron-builder --mac dir zip",
    "package:win": "pnpm build:sidecar && pnpm build && electron-builder --win portable zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@videoinsight/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "^24.10.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "build": {
    "appId": "com.videoinsight.classbutton",
    "productName": "Class Button",
    "asar": true,
    "directories": {
      "output": "../dist/electron"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/bin",
        "to": "bin",
        "filter": ["**/*"]
      },
      {
        "from": "../../class-button/config/classroom.example.json",
        "to": "classroom.json"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": ["dir", "zip"]
    },
    "win": {
      "target": ["portable", "zip"]
    }
  }
}
